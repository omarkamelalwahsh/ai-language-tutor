# Backend environment example. Copy to backend/.env and replace values.

# PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/your_db_name

# Supabase / JWT settings
SUPABASE_JWT_SECRET="your_supabase_jwt_secret"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Groq API keys
GROQ_API_KEY="your_groq_api_key"
GROQ_TASK_ENGINE_API_KEY="your_optional_groq_task_engine_api_key"

# CORS origins for backend. Use comma-separated list in production.
BACKEND_CORS_ORIGINS="http://localhost:3000,https://your-production-frontend.com"
