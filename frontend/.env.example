# Frontend environment example for local development and deployment.
# Copy this file to `frontend/.env` and replace placeholder values.

# Gemini API
GEMINI_API_KEY="your_gemini_api_key"

# Frontend app URL (used for self-referential links and callbacks)
APP_URL="http://localhost:3000"

# AI/Groq keys are loaded from backend/.env for internal tooling and backend services.

# Supabase public client configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Backend API URL for production deployment
# Must include https:// or http:// to avoid relative URL resolution errors.
VITE_API_URL="https://your-backend.example.com"

# Firebase push notification configuration (optional)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_VAPID_KEY="your_firebase_web_push_vapid_key"

# Optional server-side/service keys used by maintenance scripts
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
GROQ_TASK_ENGINE_API_KEY="your_optional_groq_task_engine_api_key"
# Optional database entries used by legacy scripts
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345678
DB_NAME="AI-Native Language"
